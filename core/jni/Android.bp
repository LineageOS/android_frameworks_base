cc_library_shared {
    name: "libandroid_runtime",
    defaults: ["libandroid_runtime_defaults"],
    target: {
        host: {
            static_libs: [
                "aconfig_text_flags_c_lib",
                "aconfig_view_accessibility_flags_c_lib",
                "libaconfig_storage_read_api_cc",
                "libbase",
                "libbinary_parse",
                "libcutils",
                "libdng_sdk",
                "libft2",
                "libharfbuzz_ng",
                "libhwui",
                "libicui18n",
                "libicuuc",
                "libicuuc_stubdata",
                "libimage_io",
                "libimage_type_recognition",
                "libinput",
                "libjpeg",
                "libjpegdecoder",
                "libjpegencoder",
                "liblog",
                "libminikin",
                "libperfetto_c",
                "libpiex",
                "libpng",
                "libsqlite",
                "libstatssocket-fake",
                "libstatspull-fake",
                "libtflite_static",
                "libtiff_directory",
                "libtinyxml2",
                "libtracing_perfetto",
                "libultrahdr",
                "libutils",
                "libwebp-decode",
                "libwebp-encode",
                "libwuffs_mirror_release_c",
                "libz",
                "server_configurable_flags",
            ],
            stl: "libc++_static",
        },
        host_linux: {
            version_script: "platform/linux/libandroid_runtime_export.txt",
            static_libs: [
                "libbinder",
                "libbinder_ndk",
                "libcore_jni_flags_c",
                "libhidlbase",
            ],
        },
        darwin: {
            host_ldlibs: [
                "-framework AppKit",
            ],
            dist: {
                targets: ["layoutlib_jni"],
                dir: "layoutlib_native/darwin",
            },
            exported_symbols_list: "platform/darwin/libandroid_runtime_export.exp",
        },
        linux_glibc_x86_64: {
            ldflags: ["-static-libgcc"],
            dist: {
                targets: ["layoutlib_jni"],
                dir: "layoutlib_native/linux",
                tag: "stripped_all",
            },
        },
    },
    afdo: true,
}

cc_library_host_shared {
    name: "libandroid_runtime_ravenwood",
    stem: "libandroid_runtime",
    defaults: ["libandroid_runtime_defaults"],
    installable: false,
    visibility: ["//frameworks/base/ravenwood"],
    cflags: [
        "-D__RAVENWOOD__",
    ],
    shared_libs: [
        "libaconfig_storage_read_api_cc",
        "libbase",
        "libbinder",
        "libbinder_ndk",
        "libcore_jni_flags_c",
        "libcutils",
        "libharfbuzz_ng",
        "libhidlbase",
        "libhwui",
        "libicui18n",
        "libicuuc",
        "libimage_io",
        "libinput",
        "libjpeg",
        "liblog",
        "libminikin",
        "libperfetto_c",
        "libsqlite",
        "libtracing_perfetto",
        "libultrahdr",
        "libutils",
        "libz",
        "server_configurable_flags",
    ],
    static_libs: [
        "libicuuc_stubdata",
    ],
}

cc_library_shared {
    name: "libvintf_jni",

    srcs: [
        "android_os_VintfObject.cpp",
        "android_os_VintfRuntimeInfo.cpp",
    ],

    shared_libs: [
        "libbase",
        "liblog",
        "libnativehelper",
        "libvintf",
