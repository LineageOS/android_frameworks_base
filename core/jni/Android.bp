}

cc_library_shared {
    name: "libmedia_jni_utils",
    srcs: [
        ":libgui_frame_event_aidl",
        "android_media_Utils.cpp",
    ],

    header_libs: [
        "libgui_headers",
    ],

    shared_libs: [
        "liblog",
        "libui",
        "libutils",
    ],

    include_dirs: [
        "system/media/camera/include",
    ],

    export_include_dirs: ["."],

    cflags: [
        "-Wall",
        "-Werror",
        "-Wno-error=deprecated-declarations",
        "-Wunused",
        "-Wunreachable-code",
    ],
}

aconfig_declarations {
    name: "core_jni_flags",
    package: "com.android.base.core.jni.flags",
    container: "system",
    srcs: ["flags.aconfig"],
}

cc_aconfig_library {
    name: "libcore_jni_flags_c",
    aconfig_declarations: "core_jni_flags",
    host_supported: true,
    target: {
        windows: {
            enabled: true,
        },
    },
}
